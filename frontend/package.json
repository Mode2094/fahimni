    "next-themes": "^0.4.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^2.15.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.0",
