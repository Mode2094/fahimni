# نسخ إلى .env.local مع قيمة الإنتاج الفعلية قبل build
NEXT_PUBLIC_API_URL=/api/v1
# نطاق المنصة الرئيسي (بدون بروتوكول) — يتجنب الـ proxy استدعاء API في كل صفحة
# يُستخدم أيضاً كأساس للـ canonical/sitemap/robots. في الإنتاج اضبطه على الدومين الفعلي.
NEXT_PUBLIC_PLATFORM_DOMAIN=app.lmsplatform.com

# ── SEO / Verification ──────────────────────────────────────────────
# Google Search Console verification token (بدون fake — ضع القيمة الحقيقية من GSC)
NEXT_PUBLIC_GSC_VERIFICATION=
# Bing Webmaster verification token
NEXT_PUBLIC_BING_VERIFICATION=
# IndexNow key (سيرفر-سايد فقط). ضع <key>.txt في public/ بعد ضبطه.
INDEXNOW_KEY=