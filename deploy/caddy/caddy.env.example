# ─────────────────────────────────────────────────────────────────────────────
# Fahimni — standalone Caddy edge configuration (NOT secret).
#
# fresh-install.sh writes the real file to /etc/fahimni/caddy.env (mode 600).
# Nothing here is sensitive: it holds only public hostnames and an ACME email.
# ─────────────────────────────────────────────────────────────────────────────

# Compose project (scopes the caddy_data/caddy_config volumes).
COMPOSE_PROJECT_NAME=fahimni

# Shared bridge network between the Fahimni nginx and this Caddy container.
# Created by fresh-install.sh; the app's docker-compose.yml joins it too.
FAHIMNI_PROXY_NETWORK=fahimni-proxy

# Public hostnames (must resolve to THIS VPS before certificates can issue).
FAHIMNI_DOMAIN=fahimni.me
FAHIMNI_API_DOMAIN=api.fahimni.me

# nginx alias on the proxy network — must equal PROXY_ALIAS in production.env.
FAHIMNI_UPSTREAM=fahimni-prod:80

# ACME (Let's Encrypt) account email — REQUIRED for automatic HTTPS.
ACME_EMAIL=admin@fahimni.me
