# ─────────────────────────────────────────────────────────────────────────────
# Fahimni — STAGING stack
#
# This file is a template. Generate the real /etc/fahimni/staging.env with:
#   deploy/scripts/init-env.sh --env staging --out /etc/fahimni/staging.env
# then fill every remaining CHANGE_ME value. Never commit the generated file.
#
# Domains: https://staging.fahimni.me  +  https://api-staging.fahimni.me
# Staging is protected by Caddy basic auth and sends X-Robots-Tag: noindex.
# ─────────────────────────────────────────────────────────────────────────────

# Compose isolation — distinct project, ports, network, volumes and database.
COMPOSE_PROJECT_NAME=fahimni-staging
IMAGE_TAG=CHANGE_ME_RELEASE_SHA
BIND_ADDR=127.0.0.1
APP_PORT=8081
HTTPS_PORT=8444
CERTS_DIR=./certs
MONITORING_CERTS_DIR=./certs

# Application
APP_ENV=staging
APP_URL=https://api-staging.fahimni.me
FRONTEND_URL=https://staging.fahimni.me
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=staging.fahimni.me,api-staging.fahimni.me
CORS_ALLOWED_ORIGINS=https://staging.fahimni.me

# Database + Redis (init-env.sh fills the passwords).
DB_DATABASE=fahimni_staging
DB_USERNAME=fahimni_staging
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

CACHE_PREFIX=fahimni_staging_
HORIZON_PREFIX=fahimni_staging_horizon_

# Mail / first admin (use a mailbox you control; never real customer data).
MAIL_FROM_ADDRESS=noreply@fahimni.me
MAIL_FROM_NAME="Tadreesly Staging"
HORIZON_MAIL_TO=CHANGE_ME_OPS_EMAIL
SUPER_ADMIN_EMAIL=CHANGE_ME_STAGING_ADMIN_EMAIL
SUPER_ADMIN_PASSWORD=CHANGE_ME_STAGING_ADMIN_PASSWORD
SUPER_ADMIN_NAME="Fahimni Staging Admin"

# Browser-visible frontend values (baked into the Next.js bundle at build).
# Keep the API same-origin: the BFF session cookie is HttpOnly and would be
# dropped by an absolute cross-origin API URL. nginx routes /api/ to Laravel.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_PLATFORM_DOMAIN=staging.fahimni.me

# ─── Freemius (Sandbox only — never production keys on staging) ──
FREEMIUS_ENABLED=false
FREEMIUS_PRODUCT_ID=
FREEMIUS_API_TOKEN=
FREEMIUS_PRODUCT_SECRET_KEY=
FREEMIUS_PUBLIC_KEY=
FREEMIUS_API_URL=https://api.freemius.com
FREEMIUS_CHECKOUT_URL=https://checkout.freemius.com
FREEMIUS_SANDBOX=true
# FREEMIUS_PLAN_STARTER_MONTHLY_ID=
# FREEMIUS_PLAN_STARTER_YEARLY_ID=
# FREEMIUS_PLAN_PROFESSIONAL_MONTHLY_ID=
# FREEMIUS_PLAN_PROFESSIONAL_YEARLY_ID=
# FREEMIUS_PLAN_ENTERPRISE_MONTHLY_ID=
# FREEMIUS_PLAN_ENTERPRISE_YEARLY_ID=

# ─── Off-site backup script (host-side, not read by Laravel) ──
BACKUP_RCLONE_REMOTE=
BACKUP_RCLONE_PATH=fahimni/backups
BACKUP_AGE_RECIPIENT=
BACKUP_ENCRYPTION_PASSPHRASE_FILE=
BACKUP_ALLOW_UNENCRYPTED=0
