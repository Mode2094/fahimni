# ─────────────────────────────────────────────────────────────────────────────
# Fahimni — shared runtime configuration (production + staging)
#
# Do NOT put environment-specific domains, ports, passwords, or Freemius
# credentials here. Those live in production.env.example / staging.env.example.
#
# deploy/scripts/init-env.sh merges this file with the selected stack file and
# generates every CHANGE_ME secret locally; the generated file is never
# committed. Keep this template in sync with .env.example and config/*.php.
# ─────────────────────────────────────────────────────────────────────────────

APP_NAME=Tadreesly
APP_KEY=CHANGE_ME_APP_KEY
APP_DEBUG=false
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=CHANGE_ME_SMTP_HOST
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USER
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_ENCRYPTION=tls

SANCTUM_TOKEN_PREFIX=
SANCTUM_TOKEN_EXPIRATION=10080

# Media URLs are signed with this key; keep it different from APP_KEY so
# rotating APP_KEY never invalidates already-issued media links.
VIDEO_SIGNING_KEY=CHANGE_ME_VIDEO_SIGNING_KEY
VIDEO_SIGNING_KEY_PREVIOUS=
REFUND_WEBHOOK_SECRET=CHANGE_ME_REFUND_WEBHOOK_SECRET

# ─── Backup Center (application-level backups) ────────────────
BACKUP_DISK=backup
BACKUP_NAME_PREFIX=fahimni
BACKUP_ENCRYPTION_KEY=CHANGE_ME_BACKUP_ENCRYPTION_KEY
BACKUP_QUEUE=backups
BACKUP_JOB_TIMEOUT=7200
BACKUP_RETENTION_DEFAULT=14
BACKUP_FAILED_RETENTION_DAYS=3
BACKUP_AUTOMATIC_ENABLED=false
BACKUP_FREQUENCY=daily
BACKUP_TIME=02:00
BACKUP_WEEKLY_DAY=1
BACKUP_EXTRA_PATHS=
BACKUP_DOWNLOAD_TTL=3600

# ─── Monitoring ───────────────────────────────────────────────
MONITORING_ENABLED=true
MONITORING_SLOW_MS=1000
MONITORING_PERSIST_SLOW=true
MONITORING_SLOW_RETENTION=10000
MONITORING_COLLECT_MINUTES=5
MONITORING_SNAPSHOT_RETENTION=1440
MONITORING_SWAP_WARNING_MB=512
MONITORING_DB_SLOW_QUERY_S=5
MONITORING_QUEUE_GROWTH_WINDOW=3
MONITORING_FAILED_JOBS_WARNING=5
MONITORING_FAILED_JOBS_CRITICAL=20
MONITORING_QUEUE_PENDING_WARNING=500
MONITORING_QUEUE_PENDING_CRITICAL=2000
MONITORING_QUEUES=default,backups
MONITORING_BACKUP_MAX_AGE_HOURS=24
MONITORING_BACKUP_WARN_AGE_HOURS=12
MONITORING_BACKUP_WARN_MISSING_OFFSITE=true
MONITORING_SSL_WARN_DAYS=30
MONITORING_SSL_HIGH_DAYS=14
MONITORING_SSL_CRITICAL_DAYS=7
MONITORING_SSL_CERT_PATH=/etc/monitoring/certs/fullchain.pem
MONITORING_ALERT_COOLDOWN_MIN=15
MONITORING_ALERT_MAIL_TO=
MONITORING_ALERT_WEBHOOK_URL=
MONITORING_ALERT_WEBHOOK_SECRET=
MONITORING_UPTIME_ENABLED=false
MONITORING_UPTIME_INTERVAL_MIN=1

# ─── AI assistant ─────────────────────────────────────────────
ASSISTANT_ENABLED=true
ASSISTANT_PROVIDER=anthropic
ASSISTANT_API_KEY=
ASSISTANT_MODEL=claude-sonnet-4-5
ASSISTANT_MAX_TOKENS=1024
ASSISTANT_TIMEOUT_SECONDS=30

# ─── Frontend runtime ─────────────────────────────────────────
NEXT_REWRITE_API_TARGET=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_LARAVEL_DSN=
INDEXNOW_KEY=
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# ─── Load testing (never run against production) ───────────────
K6_BASE_URL=http://nginx:80
K6_API_URL=http://nginx:80/api/v1
K6_PLATFORM_SLUG=demo
K6_TEST_USER_EMAIL=
K6_TEST_USER_PASSWORD=
K6_TEST_TENANT_ID=
