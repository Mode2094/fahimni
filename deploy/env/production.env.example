# ─────────────────────────────────────────────────────────────────────────────
# Fahimni — PRODUCTION stack
#
# This file is a template. Generate the real /etc/fahimni/production.env with:
#   deploy/scripts/init-env.sh --env production --out /etc/fahimni/production.env
# then fill every remaining CHANGE_ME value. Never commit the generated file.
#
# Domains: https://fahimni.me  +  https://api.fahimni.me
# ─────────────────────────────────────────────────────────────────────────────

# Compose isolation — both stacks may run on the same VPS.
COMPOSE_PROJECT_NAME=fahimni
IMAGE_TAG=CHANGE_ME_RELEASE_SHA
BIND_ADDR=127.0.0.1
APP_PORT=8080
HTTPS_PORT=8443
CERTS_DIR=./certs
MONITORING_CERTS_DIR=./certs

# Application
APP_ENV=production
APP_URL=https://api.fahimni.me
FRONTEND_URL=https://fahimni.me
# Keep host-only cookies: the Next.js BFF owns browser sessions, and a
# shared ".fahimni.me" cookie would leak between production and staging.
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=fahimni.me,www.fahimni.me,api.fahimni.me
CORS_ALLOWED_ORIGINS=https://fahimni.me,https://www.fahimni.me

# Database + Redis (init-env.sh fills the passwords).
DB_DATABASE=fahimni
DB_USERNAME=fahimni
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

CACHE_PREFIX=fahimni_prod_
HORIZON_PREFIX=fahimni_prod_horizon_

# Mail / first admin (fill with real mailbox + admin address).
MAIL_FROM_ADDRESS=noreply@fahimni.me
MAIL_FROM_NAME="Tadreesly"
HORIZON_MAIL_TO=CHANGE_ME_OPS_EMAIL
SUPER_ADMIN_EMAIL=CHANGE_ME_ADMIN_EMAIL
SUPER_ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
SUPER_ADMIN_NAME="Fahimni Admin"

# Browser-visible frontend values (baked into the Next.js bundle at build).
# Keep the API same-origin: the BFF session cookie is HttpOnly and would be
# dropped by an absolute cross-origin API URL. nginx routes /api/ to Laravel.
NEXT_PUBLIC_API_URL=/api/v1
NEXT_PUBLIC_PLATFORM_DOMAIN=fahimni.me

# ─── Freemius (production — live mode) ────────────────────────
# Keep disabled until the Sandbox checklist in FREEMIUS_SETUP.md passes.
FREEMIUS_ENABLED=false
FREEMIUS_PRODUCT_ID=
FREEMIUS_API_TOKEN=
FREEMIUS_PRODUCT_SECRET_KEY=
FREEMIUS_PUBLIC_KEY=
FREEMIUS_API_URL=https://api.freemius.com
FREEMIUS_CHECKOUT_URL=https://checkout.freemius.com
FREEMIUS_SANDBOX=false
# FREEMIUS_PLAN_STARTER_MONTHLY_ID=
# FREEMIUS_PLAN_STARTER_YEARLY_ID=
# FREEMIUS_PLAN_PROFESSIONAL_MONTHLY_ID=
# FREEMIUS_PLAN_PROFESSIONAL_YEARLY_ID=
# FREEMIUS_PLAN_ENTERPRISE_MONTHLY_ID=
# FREEMIUS_PLAN_ENTERPRISE_YEARLY_ID=

# ─── Off-site backup script (host-side, not read by Laravel) ──
# Use an rclone remote configured with least-privilege object-storage keys.
BACKUP_RCLONE_REMOTE=
BACKUP_RCLONE_PATH=fahimni/backups
# Encrypt before upload: age recipient (preferred) or an OpenSSL passphrase
# file readable only by root. The script refuses to upload unencrypted data.
BACKUP_AGE_RECIPIENT=
BACKUP_ENCRYPTION_PASSPHRASE_FILE=
BACKUP_ALLOW_UNENCRYPTED=0
