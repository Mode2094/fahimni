# Environment
.env
.env.*
!.env.example

# Deployment secrets generated on the server
deploy/env/*.env
deploy/state/

# Laravel
/vendor
/storage/*.key
# Keep the runtime directory skeleton in git (placeholder files only) so a fresh
# checkout — and therefore a fresh/empty Docker volume populated from the image —
# always has the writable dirs Laravel requires. An absent storage/framework/views
# makes config('view.compiled') resolve to false (realpath() returns false) and
# `php artisan optimize` then aborts with "View path not found", so the app
# container would never reach php-fpm.
/storage/app/backups/*
!/storage/app/backups/.gitkeep
/storage/framework/cache/data/*
!/storage/framework/cache/data/.gitignore
/storage/framework/sessions/*
!/storage/framework/sessions/.gitignore
/storage/framework/views/*
!/storage/framework/views/.gitignore
/storage/logs/*
!/storage/logs/.gitignore
/bootstrap/cache/*.php
/public/storage

# Database
/database/*.sqlite

# Frontend
/node_modules
/frontend/node_modules
/frontend/.next
/frontend/out
.next/
frontend/.env.local
frontend/.env.*.local

# Agent tooling (local only)
/.claude-flow/
/.opencode/node_modules/

# PHPUnit
.phpunit.cache/

# IDE / OS
.idea/
.vscode/
.DS_Store

# Logs / build artifacts
*.log
npm-debug.log*
yarn-error.log*
tsconfig.tsbuildinfo
certs/

# Load test results
/tests/load/results/*.json
!/tests/load/results/.gitkeep
