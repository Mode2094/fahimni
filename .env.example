# نسخ إلى .env ثم توليد APP_KEY: php artisan key:generate
# ضع قيماً حقيقية فقط في .env — هذا الملف نموذج عام دون أسرار.

# ─── Docker / النشر (تُقرأ من docker-compose.yml) ───
# اسم مشروع Compose — يجب أن يختلف بين الإنتاج وStaging على نفس السيرفر
COMPOSE_PROJECT_NAME=fahimni
# وسم صور التطبيق (SHA الإصدار) — deploy.sh يضبطه تلقائياً
IMAGE_TAG=
# واجهة الاستماع لـ nginx: loopback فقط، وCaddy هو المنفذ العام 80/443
BIND_ADDR=127.0.0.1
# منفذ HTTP الداخلي على المضيف (يخدم Next.js والـ API عبر nginx معاً)
APP_PORT=8080
# منفذ HTTPS الداخلي (يخدم فقط عند تفعيل docker/nginx/optional/https.conf)
HTTPS_PORT=8443
# دليل شهادات TLS المثبتة داخل الحاويات للقراءة فقط
CERTS_DIR=./certs
MONITORING_CERTS_DIR=./certs
# كلمة مرور Postgres وRedis (غيّرها فوراً، فلا توجد كلمة مرور افتراضية آمنة)
DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME

APP_NAME=Tadreesly
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
FRONTEND_URL=https://app.example.com

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

# مفتاح توقيع روابط الفيديو والملفات المحمية — توليد: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
# يجب أن يختلف عن APP_KEY حتى لا تنكسر روابط الوسائط عند تدوير APP_KEY
VIDEO_SIGNING_KEY=
# مفتاح التوقيع السابق أثناء التدوير (اختياري)
VIDEO_SIGNING_KEY_PREVIOUS=

# سر توقيع ويبهوك الاسترجاعات النقدية (X-Webhook-Signature: sha256=HMAC(payload))
# يُضبط في لوحة البوابة (Click/wallet) لمزامنة الاسترجاعات المنفذة هناك
# توليد: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
REFUND_WEBHOOK_SECRET=

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=lms
DB_USERNAME=lms
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis
CACHE_PREFIX=lms_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=CHANGE_ME
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="LMS Platform"

# Domains whose browser requests get the stateful session pipeline (CSRF + HttpOnly session cookie).
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:8000,app.example.com
SANCTUM_TOKEN_PREFIX=
# مدة صلاحية توكنات Sanctum بالدقائق (افتراضي 7 أيام = 10080)
SANCTUM_TOKEN_EXPIRATION=10080
CORS_ALLOWED_ORIGINS=https://app.example.com

HORIZON_PREFIX=lms_horizon_
HORIZON_MAIL_TO=ops@example.com

# حساب المدير العام — يُنشأ عند أول بذر (db:seed)
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_STRONG
SUPER_ADMIN_NAME="Super Admin"

SENTRY_LARAVEL_DSN=

# ─── SEO / IndexNow / Search Console ───
# IndexNow key — يوضع <key>.txt في frontend/public/ ويُستخدم لتنبيه Bing/Fast
# عند إنشاء/تعديل/حذف صفحات عامة قابلة للفهرسة. بلا قيمة سرية هنا.
INDEXNOW_KEY=
# Search Console / Bing verification tokens (تُمرر لـ Next.js server-side)
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=

# ─── الواجهة Next.js (frontend/) ───
# عنوان الـ API الذي يراه المتصفح (يُدمج في حزمة المتصفح وقت build)
# يجب أن يبقى same-origin: كوكي الجلسة HttpOnly من BFF لا يُرسل عبر أصل مختلف.
NEXT_PUBLIC_API_URL=/api/v1
# نطاق المنصة الرئيسي (بدون بروتوكول)
NEXT_PUBLIC_PLATFORM_DOMAIN=app.example.com
# هدف إعادة توجيه /api/v1 من داخل حاوية Next.js → nginx → PHP (لا تغيّره في Docker)
NEXT_REWRITE_API_TARGET=
# خطأ اختياري في SENTRY للواجهة
NEXT_PUBLIC_SENTRY_DSN=

# ─── مساعد "اسألني" (AI Assistant for teachers) ───
# provider: anthropic | openai | none (none = تراجع حتمي بقواعد المعرفة بدون LLM)
ASSISTANT_ENABLED=true
ASSISTANT_PROVIDER=anthropic
# مفتاح API — مطلوب فقط عند استخدام LLM (إن تُرك فارغاً يعمل المساعد بالتراجع الحتمي)
ASSISTANT_API_KEY=
ASSISTANT_MODEL=claude-sonnet-4-5
ASSISTANT_MAX_TOKENS=1024
ASSISTANT_TIMEOUT_SECONDS=30


# ─── النسخ الاحتياطي الخارجي (rclone) — مثال: s3:lms-backups / gdrive:LMS ───
BACKUP_RCLONE_REMOTE=
BACKUP_RCLONE_PATH=backups
# تشفير النسخ قبل الرفع (deploy/scripts/backup-offsite.sh):
# age المفضّل — مفتاح عام فقط على السيرفر: age1...
BACKUP_AGE_RECIPIENT=
# بديل: ملف عبارة مرور يقرأه root فقط (OpenSSL AES-256)
BACKUP_ENCRYPTION_PASSPHRASE_FILE=
# رفع بدون تشفير ممنوع افتراضياً — للتجربة المحلية فقط
BACKUP_ALLOW_UNENCRYPTED=0

# ─── النسخ الاحتياطي الكامل (Backup Center) ───
# قرص التخزين (local اليوم؛ لاحقاً: s3 / object storage عبر filesystems.php)
BACKUP_DISK=backup
# بادئة اسم النسخة
BACKUP_NAME_PREFIX=SHAHEAD_BACKUP
# مفتاح تشفير configuration.enc — إن تُرك فارغاً يُستخدم APP_KEY.
# الأفضل مفتاح مستقل: BACKUP_ENCRYPTION_KEY=base64:... (32 بايت)
BACKUP_ENCRYPTION_KEY=
# Queue و timeout للوظائف الثقيلة
BACKUP_QUEUE=backups
BACKUP_JOB_TIMEOUT=7200
# الاحتفاظ الافتراضي (يُعدَّل من لوحة الأدمن)
BACKUP_RETENTION_DEFAULT=7
BACKUP_FAILED_RETENTION_DAYS=3
# الجدول الافتراضي — النسخ التلقائي لا يعمل إلا بعد التفعيل من لوحة الأدمن
BACKUP_AUTOMATIC_ENABLED=false
BACKUP_FREQUENCY=daily
BACKUP_TIME=02:00
BACKUP_WEEKLY_DAY=1
# مسارات إضافية تُنسخ (افصل بفاصلة) — مثال: uploads
BACKUP_EXTRA_PATHS=
# مدة صلاحية روابط التنزيل الموقعة (ثوانٍ)
BACKUP_DOWNLOAD_TTL=3600

# ─── المراقبة والتشغيل (Monitoring & Observability) ───
# مفتاح جمع المقاييس الرئيسي (أغلق المراقبة كلياً بـ false)
MONITORING_ENABLED=true
# عتبة الطلب البطيء (مللي ثانية) — يُسجَّل فوقها في monitoring.log
MONITORING_SLOW_MS=1000
# حفظ الطلبات البطيئة في قاعدة البيانات (monitoring_slow_requests)
MONITORING_PERSIST_SLOW=true
# الاحتفاظ بعدد سجلات الطلبات البطيئة
MONITORING_SLOW_RETENTION=10000
# دورة جمع اللقطات (دقائق)
MONITORING_COLLECT_MINUTES=5
# الاحتفاظ بعدد اللقطات في قاعدة البيانات
MONITORING_SNAPSHOT_RETENTION=1440
# حدود الإنذار على القرص/الذاكرة/CPU (نسب مئوية)
MONITORING_SWAP_WARNING_MB=512
MONITORING_DB_SLOW_QUERY_S=5
MONITORING_QUEUE_GROWTH_WINDOW=3
MONITORING_FAILED_JOBS_WARNING=5
MONITORING_FAILED_JOBS_CRITICAL=20
MONITORING_QUEUE_PENDING_WARNING=500
MONITORING_QUEUE_PENDING_CRITICAL=2000
# الطوابير المراقبة (افصل بفاصلة)
MONITORING_QUEUES=default,backups
# عمر النسخة الاحتياطية الأقصى قبل الإنذار (ساعات)
MONITORING_BACKUP_MAX_AGE_HOURS=24
MONITORING_BACKUP_WARN_AGE_HOURS=12
MONITORING_BACKUP_WARN_MISSING_OFFSITE=true
# عتبات SSL (أيام)
MONITORING_SSL_WARN_DAYS=30
MONITORING_SSL_HIGH_DAYS=14
MONITORING_SSL_CRITICAL_DAYS=7
# مسار شهادة SSL للفحص (مُثبّتة داخل الحاويات كقراءة فقط)
MONITORING_SSL_CERT_PATH=/etc/monitoring/certs/fullchain.pem
# الإنذارات — قنوات اختيارية
MONITORING_ALERT_COOLDOWN_MIN=15
MONITORING_ALERT_MAIL_TO=
MONITORING_ALERT_WEBHOOK_URL=
MONITORING_ALERT_WEBHOOK_SECRET=
# مراقبة خارجية (Uptime) — مستندة فقط، لا تؤثر على التطبيق
MONITORING_UPTIME_ENABLED=false
MONITORING_UPTIME_INTERVAL_MIN=1

# ─── Load Testing (k6) — تُستخدم من tests/load/run.sh ───
K6_BASE_URL=http://nginx:80
K6_API_URL=http://nginx:80/api/v1
K6_PLATFORM_SLUG=demo
K6_TEST_USER_EMAIL=
K6_TEST_USER_PASSWORD=
K6_TEST_TENANT_ID=

# ─── Freemius (بوابة اشتراكات المنصة الوحيدة / the ONLY platform gateway) ───
# الأسرار تُضبط في البيئة فقط — لا تُخزَّن في قاعدة البيانات ولا في git.
# راجع FREEMIUS_SETUP.md للخطوات الكاملة.
FREEMIUS_ENABLED=false
FREEMIUS_PRODUCT_ID=
FREEMIUS_API_TOKEN=
FREEMIUS_PRODUCT_SECRET_KEY=
FREEMIUS_PUBLIC_KEY=
FREEMIUS_API_URL=https://api.freemius.com
FREEMIUS_CHECKOUT_URL=https://checkout.freemius.com
FREEMIUS_SANDBOX=false
# ربط الخطط المحلية (افتراضي؛ يمكن تجاوزه من لوحة الأدمن داخل metadata الخطة):
# FREEMIUS_PLAN_STARTER_MONTHLY_ID=
# FREEMIUS_PLAN_STARTER_YEARLY_ID=
# FREEMIUS_PLAN_PROFESSIONAL_MONTHLY_ID=
# FREEMIUS_PLAN_PROFESSIONAL_YEARLY_ID=
# FREEMIUS_PLAN_ENTERPRISE_MONTHLY_ID=
# FREEMIUS_PLAN_ENTERPRISE_YEARLY_ID=

# ─── Booking gateways (مدفوعات الطلاب/الحجوزات — منفصلة عن اشتراكات المنصة) ───
# هذه البوابات تُستخدم فقط لدفع حجوزات الطلاب للمعلمين، وتُدار من لوحة الأدمن.
# لا تمر أبدًا عبر Freemius.
# PAYTABS / PAYPAL تُضبط من Admin → Settings → Payments (تُخزَّن مشفّرة).

# ─── Live Streaming (Google Meet) ────────────────────────────────
# لا اعتمادات مطلوبة — المعلم يلصق رابط meet.google.com الخاص به عند
# إنشاء الحصة. لا Google OAuth ولا Calendar API ولا حساب مشترك.

# ─── مزود الفيديو المسجّل (Bunny Stream) ─────────────────────────
# تُدخل الاعتمادات من لوحة الأدمن (Admin → Media Infrastructure) أو تُملأ
# من البيئة عند أول تشغيل: dashboard.bunny.net → Stream → Library Settings.
